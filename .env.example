APP_NAME=CarHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carhub
DB_USERNAME=carhub
DB_PASSWORD=

# Cache / Queue / Session — production: redis ; local: file/sync/file
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Mail — production: use a real mailer (ses, postmark, resend...)
MAIL_MAILER=log

# Sanctum (CORS/stateful domains for web + admin)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Pagar.me (required for real payments — request from client dashboard)
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
PAGARME_WEBHOOK_SECRET=
PAGARME_PLATFORM_RECIPIENT_ID=

# Firebase Cloud Messaging (FCM) — for push notifications
# Place the service account JSON at storage/firebase-service-account.json
FIREBASE_CREDENTIALS=storage/firebase-service-account.json

# Filesystem — "public" for local, switch to "s3" when using DO Spaces/AWS
FILESYSTEM_DISK=public

# Optional: Sentry for crash reporting (add later)
# SENTRY_LARAVEL_DSN=
